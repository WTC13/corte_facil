<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{#if title}}{{title}} · {{/if}}{{appName}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/choices.js@10.2.0/public/assets/styles/choices.min.css" rel="stylesheet">
  <link href="/css/app.css" rel="stylesheet">
</head>
<body>
<div class="shell">

  <aside class="sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="sidebar" aria-label="Menu principal">
    <div class="sidebar-inner">
      <div class="brand">
        <span class="brand-mark"><i class="bi bi-scissors"></i></span>
        <div>
          <strong>{{appName}}</strong>
          <small>{{enterprise.name}}</small>
        </div>
      </div>

      <nav class="side-nav">
        {{#each nav}}
          <a href="{{../prefix}}{{this.href}}" class="side-link {{#if (eq ../active this.key)}}is-active{{/if}}">
            <i class="bi {{this.icon}}"></i><span>{{this.label}}</span>
          </a>
        {{/each}}
      </nav>

      <div class="side-foot">
        <div class="user-chip">
          <span class="avatar" style="background:hsl({{hue user.name}} 35% 42%)">{{initials user.name}}</span>
          <div>
            <strong>{{user.name}}</strong>
            <small>{{user.role}}</small>
          </div>
        </div>
        {{!-- Atalho só do preview: alternar entre as duas visões --}}
        {{#if (eq area 'owner')}}
          <a class="side-mini" href="{{prefix}}/client/book"><i class="bi bi-arrow-left-right"></i> Ver como assinante</a>
        {{else}}
          <a class="side-mini" href="{{prefix}}/owner/dashboard"><i class="bi bi-arrow-left-right"></i> Ver como dono</a>
        {{/if}}
        <a class="side-mini" href="{{prefix}}/login"><i class="bi bi-box-arrow-left"></i> Sair</a>
      </div>
    </div>
    <span class="pole pole-edge" aria-hidden="true"></span>
  </aside>

  <div class="main">
    <header class="topbar d-lg-none">
      <button class="btn btn-ink btn-sm" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-controls="sidebar">
        <i class="bi bi-list"></i> Menu
      </button>
      <strong>{{appName}}</strong>
    </header>
    <main class="content">
      {{{body}}}
    </main>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.14.5/dist/sweetalert2.all.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/choices.js@10.2.0/public/assets/scripts/choices.min.js"></script>
<script src="/js/app.js"></script>
</body>
</html>
